label sm1cs_vs003:
    $ renpy.music.set_volume(0.8, 0.5, "music" )
    $ renpy.music.set_volume(0.0, 1.0, "freeroam_music1" )
    $ renpy.music.set_volume(0.0, 1.0, "freeroam_sound1" )
    $ renpy.music.set_volume(0.0, 1.0, "freeroam_sound2" )
    play music music_silly_silhouette fadein 1.5
    play sound sfx_heels_steps2 loop
    scene sm1cs-vs003-01 mc-vs-tl-entry_c1 with dissolve
    play voice2 mc_hey_hey7 noloop
    mc "Hey, Veronica."
    scene sm1cs-vs003-01 mc-vs-tl-entry_c2 with dissolve
    play voice3 girl33_hey_involved noloop
    vs "Hiya, [mcname]."
    scene sm1cs-vs003-01 mc-vs-tl-entry_c3 with dissolve
    pause
    play sound sfx_cloth_rustling1
    scene sm1cs-vs003-02 mc-vs-tl-look_c2 with dissolve
    play voice3 girl33_disappointed_off noloop
    vs "Ooooh."
    vs "*whispers* Hey... {w}Did our special alarm go off?"
    scene sm1cs-vs003-02 mc-vs-tl-look_c1 with dissolve
    play voice2 d4s4_mclaugh noloop
    mc "*chuckles* No, not yet."
    mc "Shall I move up the timer?"
    scene sm1cs-vs003-03 mc-vs-tl-look2_c2 with dissolve
    play voice3 girl33_happy_laugh1 noloop
    vs "Haha. No. That would be cheating."
    vs "And... part of the fun is not knowing when the bell will ring.{w} At least... it is for me."
    play sound sfx_cloth_rustling2
    scene sm1cs-vs003-04 mc-vs-tl-look3_c2 with dissolve
    play voice3 girl33_happy_laugh2 noloop
    vs "Way to go. Now I'm bummed. *giggles*"
    scene sm1cs-vs003-05 mc-vs-tl-talk_c1 with dissolve
    play voice4 girl24_surprised_huh3 noloop
    tl "What are you two chatting about? Did Denise finally tell Pixie what the new show is going to be?"
    scene sm1cs-vs003-06 mc-vs-tl-talk2_c2 with dissolve
    play voice3 girl33_no_simple noloop
    vs "Not yet, Taisia. But she's close to cracking. I know she is."
    play sound sfx_cloth_rustling4
    scene sm1cs-vs003-07 mc-vs-tl-look_c2 with dissolve
    play voice3 girl33_arrogant_huh1 noloop
    vs "[mcname] asked me to run a scene with him, Taisia. Do you want to come join us?"
    scene sm1cs-vs003-07 mc-vs-tl-look_c1 with dissolve
    play voice4 girl24_no_nah noloop
    tl "Nah. I don't need to break a sweat if it's not official theater work."
    scene sm1cs-vs003-07 mc-vs-tl-look_c3 with dissolve
    play voice3 girl33_disappointed_aah noloop
    vs "Come on, it will be fun. Please."
    play sound sfx_cloth_rustling1
    scene sm1cs-vs003-08 mc-vs-tl-look2_c1 with dissolve
    play voice4 girl24_surprised_oh1 noloop
    tl "You know what? That does sound like fun.{w} Oh wait, I have this thing and-"
    play sound sfx_heels_steps1
    scene sm1cs-vs003-09 mc-vs-tl-walk_c2 with dissolve
    stop sound fadeout 3.5
    play voice3 girl33_arrogant_hm noloop
    vs "Well, I tried. Looks like it will just be the two of us."
    scene sm1cs-vs003-09 mc-vs-tl-walk_c1 with dissolve
    play voice2 mc_yes_yeah5 noloop
    mc "I guess Taisia can't be bothered with extra work."
    play sound sfx_cloth_rustling2
    scene sm1cs-vs003-10 mc-vs-tl-talk_c2 with dissolve
    play voice3 girl33_yes_aga noloop
    vs "That's okay. There are plenty of fun two-person sets we can work on."
    vs "Mmm. So, are you ready for some practice?"
    scene sm1cs-vs003-10 mc-vs-tl-talk_c1 with dissolve
    play voice2 mc_yes_sure1 noloop
    mc "Sure, I'd appreciate some tips and tricks from you."
    play sound sfx_cloth_rustling3
    scene sm1cs-vs003-11 mc-vs-tl-talk2_c1 with dissolve
    play voice2 d1s5_mchappy noloop volume 1.7
    if True:
        mc "Gotta be ready for when Denise gives me another shot at becoming an actor."
        scene sm1cs-vs003-11 mc-vs-tl-talk2_c2 with dissolve
        play voice3 girl33_happy_yay noloop
        vs "That's the spirit."
    else:
        mc "I finally got a spot with the acting crew, but I'm still eager to hone my craft."
        scene sm1cs-vs003-11 mc-vs-tl-talk2_c2 with dissolve
        play voice3 girl33_happy_yay noloop
        vs "Totally. Work hard enough, and maybe you'll be half as good as me one day."
        scene sm1cs-vs003-12 mc-vs-tl-talk3_c1 with dissolve
        play voice2 mc_arrogant_heh3 noloop
        mc "Haha. Right..."
    scene sm1cs-vs003-12 mc-vs-tl-talk3_c2 with dissolve
    play voice3 girl33_thinking_hmm3 noloop
    vs "How about we focus on dialogue training? We can work on your delivery."
    menu:
        "What's wrong with my delivery?"(hint="sm1cs_vs003_m01_h01"):
            scene sm1cs-vs003-13 mc-vs-tl-talk4_c1 with dissolve
            play voice2 mc_thinking_wait3 noloop
            mc "Wait, what's wrong with my delivery?"
            scene sm1cs-vs003-13 mc-vs-tl-talk4_c2 with dissolve
            play voice3 girl33_disappointed_oh noloop
            vs "Oh... it's nothing a little practice won't fix."
            vs "But sometimes, you just come off a little flat."
            play voice2 mc_thinking_mmm4 noloop
            mc "Hmmm."
        "Sounds good, Veronica."(hint="sm1cs_vs003_m01_h02"):
            call sm1cs_vs003_m01_c02 from _call_sm1cs_vs003_m01_c02
            scene sm1cs-vs003-14 mc-vs-tl-talk5_c1 with dissolve
            play voice2 d9s2_yeah noloop volume 2.3
            mc "Sounds good."
            play sound sfx_hair_scratch1
            scene sm1cs-vs003-15 mc-vs-tl-talk6_c1 with dissolve
            play voice2 mc_wink_kk noloop volume 1.67
            pause
            scene sm1cs-vs003-14 mc-vs-tl-talk5_c2 with dissolve
            vs "..."
            scene sm1cs-vs003-16 mc-vs-tl-talk7_c1 with dissolve
            play voice2 mc_yes_yeah2 noloop
            mc "There we go."
            scene sm1cs-vs003-15 mc-vs-tl-talk6_c2 with dissolve
            play voice3 girl33_surprised_what noloop
            vs "What was that?"
            scene sm1cs-vs003-16 mc-vs-tl-talk7_c1 with dissolve
            play voice2 mc_arrogant_heh1 noloop
            mc "I was opening up my brain so you can fill it with your knowledge."
            scene sm1cs-vs003-16 mc-vs-tl-talk7_c2 with dissolve
            play voice3 girl33_happy_laugh4 noloop
            pause
    play sound sfx_skirt_off1
    scene sm1cs-vs003-17 mc-vs-tl-look_c1 with dissolve
    play sound2 sfx_phone_tapping1 volume 2.5
    play voice3 girl33_thinking_eem2 noloop
    vs "Let me find the perfect scene."
    scene sm1cs-vs003-17 mc-vs-tl-look_c2 with dissolve
    play voice2 d1s5_mcthinks noloop volume 1.6
    mct "I wonder what she's cooking up."
    stop sound2 fadeout 1.0
    scene sm1cs-vs003-18 mc-vs-tl-look2_c1 with dissolve
    play voice3 girl33_yes_yep noloop
    vs "Here we go. Sending it to you now."
    jump sm1cs_vs003_later
