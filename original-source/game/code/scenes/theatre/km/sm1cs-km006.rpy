label sm1cs_km006:
    $ renpy.music.set_volume(0.7, 0.5, "music" )
    $ renpy.music.set_volume(0.0, 1.0, "freeroam_music1" )
    $ renpy.music.set_volume(0.0, 1.0, "freeroam_sound1" )
    $ renpy.music.set_volume(0.0, 1.0, "freeroam_sound2" )
    play music music_theatrical_life1
    play sound sfx_heels_steps1 loop
    play sound2 sfx_heels_steps2
    if curr_sublocation == LTH_SUB_STAGE:
        scene sm1cs-km006-02 mc-km-stretch-scene_c1 with dissolve
    else:
        scene sm1cs-km006-01 mc-km-walk-on-stage_c1 with Fade(0.5, 0.5, 0.5)
    pause
    stop sound fadeout 1.0
    stop sound2 fadeout 1.0
    scene sm1cs-km006-03 mc-choice-menu-screen_c1 with dissolve
    menu:
        "Sure. Just practicing.":
            scene sm1cs-km006-04 choice-sure-just-practicing_c1 with dissolve
            play voice2 mc_yes_sure1 noloop
            mc "Sure. We're just practicing."
            jump sm1cs_km006_after_menu
        "You sound bitter about what we did":
            $ player.set_choice("sm1cs_km006_km_bitter")
            play sound sfx_cloth_rustling3
            scene sm1cs-km006-05 choice-mc-sound-bitter-km-thought-not-gonna-talk-about-it_c1 with dissolve
            play voice2 mc_arrogant_huh1 noloop
            mc "You sound a bit bitter about what we did."
            play voice3 girl31_disappointed_ehh1 noloop
            km "I thought we were skipping that topic."
            scene sm1cs-km006-06 mc-shrugs-not-discuss-crush-veronica-not-amazing-boobjob_c1 with dissolve
            play voice2 mc_hey_hey3 noloop
            mc "I thought we were skipping talk about your crush on, Veronica."
            mc "Not how good you are at boobjobs."
            play sound sfx_hair_scratch1
            scene sm1cs-km006-07 km-blushing-you-impossible-regular-coriolanus_c1 with dissolve
            play voice3 girl31_arrogant_geh noloop
            km "*grunts* You are impossible."
            km "A regular Coriolanus."
            scene sm1cs-km006-08 mc-good-km-do-even-know-who-he-is_c1 with dissolve
            play voice2 mc_arrogant_hm1 noloop
            mc "Good."
            jump sm1cs_km006_menu_2
label sm1cs_km006_menu_2:
    play voice3 girl31_surprised_huh3 noloop
    km "Do you even know who Coriolanus is?"
    scene sm1cs-km006-09 mc-choice-menu_c1 with dissolve
    menu:
        "No, but I like his name":
            $ player.set_choice("sm1cs_km006_like_name")
            $ CharacterController.get_character("km").add_point()
            scene sm1cs-km006-10 choice-like-name-mc-no-but-like-name-km-smiling-fits-you-perfectly_c1 with dissolve
            play voice2 mc_no_no2 noloop
            mc "Not, but I like this name."
            play voice3 girl31_arrogant_he noloop
            km "It fits you perfectly. He never knew when to shut up."
            scene sm1cs-km006-11 km-closes-eyes-km-alliegence-himself-mc-what-not-like-that_c1 with dissolve
            play voice3 girl31_arrogant_hm1 noloop
            km "And his only allegiance was to himself."
            play voice2 mc_surprised_what3 noloop
            mc "What?{w} I'm not like that at all."
            scene sm1cs-km006-12 km-hmm-gues-not-all-bad_c1 with dissolve
            play voice3 girl31_thinking_hmm1 noloop
            km "Hmmm.{w} I guess you're not all bad."
        "Don't make me banish you from my presence, Kellie" if player.get_topic(TOPIC_LITERATURE) > 6:
            $ player.set_choice("sm1cs_km006_banish_km")
            $ CharacterController.get_character("km").add_point(2)
            play sound sfx_cloth_rustling1
            scene sm1cs-km006-13 choice-not-make-banish-mc-dont-make-banish-you_c1 with dissolve
            play voice2 mc_angry_cough1 noloop
            mc "Don't make me banish you from my presence, Kellie."
            scene sm1cs-km006-14 km-impressed-maybe-more-than-big-dick-haah_c1 with dissolve
            play voice3 girl31_thinking_hmm1 noloop
            km "Hmmm. Maybe there is more to you than just a big dick."
            km "Hahah."
        "Yes. He's the one that got stabbed thirty times":
            $ player.set_choice("sm1cs_km006_stabbed_thirty_times")
            scene sm1cs-km006-15 choice-thirty-times-mc-guy-stabbed-thirty-times-km-that-caesar_c1 with dissolve
            play voice2 mc_yes_yes6 noloop
            mc "Yes. He's the one who got stabbed thirty times."
            play voice3 girl31_no_simple noloop
            km "That was Julius Caesar."
            mc "Nah, I'm pretty sure it was Curio Linus."
            scene sm1cs-km006-16 mc-pretty-sure-curio-km-flustered-coriolan_c1 with dissolve
            play voice3 girl31_disappointed_ehh2 noloop
            km "Coriolan-"
            scene sm1cs-km006-17 km-you-teasing-me-mc-had-to_c1 with dissolve
            play voice3 girl31_angry_kghh2 noloop
            km "You're teasing me."
            play voice2 mc_yes_aga1 noloop
            mc "I had to. I like it when you get all flustered."
            play sound sfx_heels_steps1 loop
            scene sm1cs-km006-18 km-walk-away-acting-km-perhaps-dont-need-me_c1 with dissolve
            play voice3 girl31_arrogant_yeah2 noloop
            km "Perhaps you don't need my help today."
            stop sound fadeout 1.0
            scene sm1cs-km006-19 mc-begs-km-stick-around-mc-no-more-jokes-km-mm-will-see_c1 with dissolve
            play voice2 mc_no_no4 noloop
            mc "Wait.{w} Please, Kellie."
            mc "No more jokes.{w} I'm all in."
            play voice3 girl31_thinking_hmm1 noloop
            km "Mmm. We will see."
    jump sm1cs_km006_after_menu
label sm1cs_km006_after_menu:
    play sound sfx_cloth_rustling2
    scene sm1cs-km006-20 km-takes-phone-come-on-start-reading_c1 with dissolve
    play voice3 girl31_yes_aga noloop
    km "Come on.{w} Start reading the lines for Hooper."
    play sound sfx_cloth_rustling3
    scene sm1cs-km006-21 mc-look-phone-got-it-hooper_c1 with dissolve
    play voice2 mc_yes_ugu1 noloop
    mc "Got it.{w} Hooper."
    scene sm1cs-km006-22 km-looks-around-km-need-someone-standin-mc-oh-three-person-scene_c1 with dissolve
    play voice3 girl31_thinking_emm3 noloop
    km "We just need one person as a standin for the Mayor."
    play voice2 mc_thinking_oh1 noloop
    mc "Oh, so it's a three person scene?"
    play sound sfx_double_door1 volume 0.4
    scene sm1cs-km006-23 km-not-really-they-trying-warn-him_c1 with dissolve
    play voice3 girl31_no_questioning noloop
    km "Kind of.{w} Most of the heavy lifting is done by two, but you need a grumpy authority figure."
    km "They're trying to warn him, but he wants to keep the beaches open when there is a shark in the water."
    scene sm1cs-km006-24 mc-hmm-sounds-familiar_c1 with dissolve
    play voice2 mc_thinking_hmm1 noloop
    mc "Hmmm. Sounds familiar."
    play sound2 sfx_carpet_footsteps1
    $ renpy.music.set_volume(0.5, 0.5, "music2" )
    play music2 music_adroids_metal_headphoned
    scene sm1cs-km006-25 kw-walks-in-listening-headphones_c1 with dissolve
    pause
    scene sm1cs-km006-26 km-sees-kw-waves-hey-kai-give-us-hand_c1 with dissolve
    play voice3 girl31_hey_high noloop
    km "Hey Kai.{w} Can you give us a hand for a bit?"
    $ renpy.music.set_volume(1.0, 1.0, "music2" )
    play sound sfx_skirt_off2
    scene sm1cs-km006-27 kw-huh-km-read-lines-us_c1 with dissolve
    play voice4 boy10_surprised_huh noloop
    kw "Huh?"
    play voice3 girl31_thinking_hmm4 noloop
    km "Can you read some lines with us?{w} We need a stand in."
    scene sm1cs-km006-28 km-just-few-lines-kw-for-you-anything_c1 with dissolve
    play voice3 girl31_thinking_hm noloop
    km "Just a few runs."
    play voice4 boy10_yes_happy noloop
    kw "For you, Kellie. Anything."
    stop music2 fadeout 1.5
    play sound sfx_heels_steps1 loop
    play sound2 sfx_heels_steps2
    scene sm1cs-km006-29 gang-starts-rehearsing_c1 with dissolve
    pause
    stop sound fadeout 1.0
    stop sound2 fadeout 1.0
    scene sm1cs-km006-30 km-this-great-white-larry-man-eater_c1 with dissolve
    play voice3 girl31_angry_cough4 noloop
    km "This is a Great White, Larry, a big one!{w} And any shark expert in the world will tell you it's a killer!"
    km "It's a man-eater!"
    scene sm1cs-km006-31 mc-look-the-situation-mc-going-continue-feed_c1 with dissolve
    play voice2 mc_thinking_emm1 noloop
    mc "Look the situation, is that apparently a Great White shark has staked a claim in the waters off Amity Island."
    mc "And he's going to continue to feed here as long as there is food in the water."
