label sm1cs_dvh001:
    $ renpy.music.set_volume(0.5, 0.5, "music" )
    $ renpy.music.set_volume(0.0, 1.0, "freeroam_music1" )
    $ renpy.music.set_volume(0.0, 1.0, "freeroam_sound1" )
    $ renpy.music.set_volume(0.0, 1.0, "freeroam_sound2" )
    scene sm1cs-dvh001-01 mc-dvh-walk-in-smoking-cigarette with dissolve
    play sound sfx_cigarette_breathe1
    play music music_newspurs_western
    pause
    stop sound fadeout 1.0
    scene sm1cs-dvh001-02 mc-dvh-pov-talk with dissolve
    play voice3 girl34_disappointed_oh2 noloop
    dvh "Oh, it is just you."
    play voice2 d2s9_confused noloop volume 1.7
    mc "Uh, yep. Just me. [mcname], if you don't remember."
    scene sm1cs-dvh001-03 mc-dvh-pov-talk-alt-camera with dissolve
    play voice3 girl34_arrogant_yeah noloop
    dvh "Taisia's recommendation, ya?"
    play voice2 mc_yes_yes3 noloop
    mc "The very one."
    scene sm1cs-dvh001-04-01 mc-dvh-looking-up-and-down with dissolve
    play voice2 d1s1_mmm noloop
    mct "Is she checking me out? No, no way."
    scene sm1cs-dvh001-04-02 mc-dvh-looking-up-and-down with dissolve
    play voice3 girl34_thinking_eeh1 noloop
    dvh "I shall return to the stage in a moment. Just need some time to breath deep."
    play voice2 mc_arrogant_huh1 noloop
    mc "Huh..."
    scene sm1cs-dvh001-05 mc-dvh-annoyed-talk with dissolve
    play voice3 girl34_yes_questioning2 noloop
    dvh "Yes?"
    play voice2 mc_thinking_emm1 noloop
    mc "I just... Thought smoking and breathing deep were polar opposites."
    play sound sfx_cloth_rustling1
    scene sm1cs-dvh001-06 mc-dvh-roll-eyes-ridiculous-talk with dissolve
    play voice3 girl34_angry_argh2 noloop
    dvh "And why do I care?"
    play voice2 mc_arrogant_hm3 noloop
    mc "I, uh... Guess you shouldn't. It's just, bad for you."
    scene sm1cs-dvh001-07 mc-dvh-ridiculous-talk-wave-hand-alt with dissolve
    play voice3 girl34_disgust_ooh2 noloop
    dvh "Oh yes, you are the first person to tell me this."
    play voice2 mc_yes_yeah8 noloop
    mc "Really?"
    scene sm1cs-dvh001-08 mc-dvh-talk-expecting-response with dissolve
    play voice3 girl34_no_nouh3 noloop
    dvh "No. Of course I know it is bad for me. But helaas, pindakaas."
    play voice2 mc_arrogant_heh1 noloop
    mc "Huh?"
    play voice3 girl34_angry_breath1 noloop
    dvh "Do not worry. Did you come out here just to admonish me for my habit, or is there something you wanted to discuss?"
    scene sm1cs-dvh001-09 mc-dvh-talk-mc-response with dissolve
    play voice2 mc_thinking_hmm1 noloop
    mc "Actually, there is something I wanted to talk to you about."
    mc "During my audition, you said I had potential."
    scene sm1cs-dvh001-08 mc-dvh-talk-expecting-response with dissolve
    play voice3 girl34_yes_neutral3 noloop
    dvh "Yes. But even a stray can become a pet."
    play voice2 mc_disappointed_ehh5 noloop
    mc "Uhhh, sure?"
    scene sm1cs-dvh001-10 mc-dvh-glaring-at-mc with dissolve
    mct "What the hell does that mean?"
    play voice2 mc_thinking_hmm4 noloop
    mc "I was wondering if you could teach me how to become a better actor."
    play sound sfx_cloth_rustling2
    scene sm1cs-dvh001-06 mc-dvh-roll-eyes-ridiculous-talk with dissolve
    play voice3 girl34_surprised_huh5 noloop
    dvh "You are looking for a mentor?"
    play voice2 mc_yes_yeah2 noloop
    mc "Something like that, yeah."
    play voice3 girl34_surprised_why2 noloop
    dvh "Why?"
    scene sm1cs-dvh001-09 mc-dvh-talk-mc-response with dissolve
    play voice2 mc_thinking_mmm4 noloop
    mc "I had a... Someone close to me told me that I needed to work on my acting skills."
    play voice3 girl34_thinking_hmm2 noloop
    dvh "They are not wrong."
    scene sm1cs-dvh001-11 mc-dvh-talk-wide-shot with dissolve
    play voice2 mc_yes_aga2 noloop
    mc "And I figure that if you're the director here, that you'd be the best person for me to talk to."
    play sound sfx_cigarette_breathe3
    scene sm1cs-dvh001-12 mc-dvh-smoke-interrupt with dissolve
    pause
    play sound sfx_cigarette_exhale3
    scene sm1cs-dvh001-13 mc-dvh-blow-smoke with dissolve
    pause
    stop sound fadeout 1.0
    scene sm1cs-dvh001-14 mc-dvh-annoyed-done-smoking with dissolve
    play voice3 girl34_arrogant_huh1 noloop
    dvh "Why do you want to act?"
    mct "Probably shouldn't tell her it's for porn."
    play voice2 mc_thinking_mmm5 noloop
    mc "I, uhh, recently discovered a love for... the theater?"
    mct "Smooth as butter. I really should have come here with a better plan."
    play sound sfx_cloth_rustling1
    scene sm1cs-dvh001-15 mc-dvh-talk-stasnd-up with dissolve
    play voice3 girl34_thinking_hmm7 noloop
    dvh "Hmmm."
    play voice2 mc_thinking_hmm5 noloop
    mc "My... Friend wants to cast me in some short films. And Taisia recommended I come and audition."
    scene sm1cs-dvh001-16 mc-dvh-talk-annoyed with dissolve
    play voice3 girl34_yes_aga8 noloop
    dvh "I see. What attracted you to acting?"
    scene sm1cs-dvh001-17 mc-dvh-talk-confused with dissolve
    play voice2 mc_hey_hey7 noloop
    mc "Who doesn't want to be a big famous actor?"
    mc "So can you help me?"
    scene sm1cs-dvh001-18 mc-dvh-listening-menu-pop-up with dissolve
    play voice3 girl34_no_angry6 noloop
    dvh "Simply, no."
    scene sm1cs-dvh001-17 mc-dvh-talk-confused with dissolve
    play voice2 mc_surprised_why4 noloop
    mc "Wait... Why?"
    scene sm1cs-dvh001-16 mc-dvh-talk-annoyed with dissolve
    play voice3 girl34_angry_dough noloop
    dvh "Because I know men like you. You are only interested in acting to sleep with women."
    scene sm1cs-dvh001-19 mc-dvh-1st-response-positive-talk with dissolve
    play voice2 mc_disappointed_ah2 noloop
    mc "Well that's not-"
    scene sm1cs-dvh001-20 mc-dvh-1st-response-positive-talk-surprised with dissolve
    play voice3 girl34_arrogant_ha3 noloop
    dvh "My first time directing a play, \"Soldier of Yellow\", I wanted to do something daring and bold."
    scene sm1cs-dvh001-21 mc-dvh-2nd-response-negative-talk-lie with dissolve
    play voice2 mc_yes_aga1 noloop
    mc "Uh huh?"
    scene sm1cs-dvh001-22 mc-dvh-2nd-response-negative-talk-roll-eyes with dissolve
    play voice3 girl34_disappointed_eeh2 noloop
    dvh "I had grown tired of the same old men, directing the same old shows, with the same old actors."
    dvh "I held an open casting, for men who had never acted before but wanted to learn."
    dvh "I shall never forget. Bram, was his name. Dashing, funny, hazel eyes, dark swagger. As if he had walked out of a Rembrandt."
    dvh "He was the obvious choice. His acting was... Less than impeccable, but he had raw talent. He had drive."
    scene sm1cs-dvh001-23 mc-dvh-continue-talk with dissolve
    play voice2 mc_surprised_wow3 noloop
    mc "Sounds like he was just what you were looking for."
    scene sm1cs-dvh001-20 mc-dvh-1st-response-positive-talk-surprised with dissolve
    play voice3 girl34_yes_angry1 noloop
    dvh "That is what I thought as well. He got on stage with the leading lady. They had such chemistry we knew that we were going to have a hit."
    dvh "Until Bram decided that he was more interested bedding actress than performing. He stopped bothering to show up. And so did the actress."
    dvh "In the end, the show flopped. There was not enough time to teach anyone else the part. I became a laughing stock."
    play voice2 mc_angry_hm2 noloop
    mct "God... That Bram guy was an asshole."
    scene sm1cs-dvh001-16 mc-dvh-talk-annoyed with dissolve
    play voice3 girl34_hey_angry7 noloop
    dvh "Now tell me, in this moment, how are you different than Bram? A man off the street, wanting to act, with eyes only for the woman."
    play voice2 mc_pain_ou1 noloop
    mct "Oh shit. I mean... She's not wrong. What the hell can I say?"
    menu:
        "Tell Denise why you're different"(hint="sm1cs_dvh001_m01_h01"):
            call sm1cs_dvh001_m01_c01 from _call_sm1cs_dvh001_m01_c01
            scene sm1cs-dvh001-17 mc-dvh-talk-confused with dissolve
            play voice2 mc_disappointed_ehh1 noloop
            mc "Uhhh. You know, you're right."
            play voice3 girl34_yes_yeah3 noloop
            dvh "I know."
            play voice2 mc_thinking_mmm6 noloop
            mc "I do want to use the skills I learn here to be... More confident with women."
            scene sm1cs-dvh001-20 mc-dvh-1st-response-positive-talk-surprised with dissolve
            play voice3 girl34_disappointed_oh1 noloop
            dvh "What a shock?"
            scene sm1cs-dvh001-21 mc-dvh-2nd-response-negative-talk-lie with dissolve
            play voice2 mc_yes_yeah3 noloop
            mc "But I also want to act. I think there's a lot more to learn here than just on how to be confident with women."
            scene sm1cs-dvh001-22 mc-dvh-2nd-response-negative-talk-roll-eyes with dissolve
            play voice3 girl34_arrogant_ha2 noloop
            dvh "Huh. Most men would lie when faced with such an accusation. I am impressed you told me the truth."
        "Tell Denise that you're only interested in acting"(hint="sm1cs_dvh001_m01_h02"):
            scene sm1cs-dvh001-17 mc-dvh-talk-confused with dissolve
            play voice2 mc_no_no8 noloop
            mc "No, I, uhm, am really interested in the art of... Acting."
            play voice3 girl34_yes_yeah3 noloop
            dvh "That is what they all say."
            play voice2 mc_hey_hey2 noloop
            mc "Seriously! I, uh, love Shakespeare."
            scene sm1cs-dvh001-18 mc-dvh-listening-menu-pop-up with dissolve
            play voice3 girl34_yes_aga7 noloop
            dvh "Of course you do."
    scene sm1cs-dvh001-23 mc-dvh-continue-talk with dissolve
    play voice2 d1s5_mchappy noloop volume 1.7
    mc "I've got a have a vested interest in learning more about acting. I hope it's something I'll be doing a lot of in the near future."
    mct "Which isn't really a lie. Should just probably leave out the part about it being for porn."
    play sound sfx_cigarette_breathe1
    scene sm1cs-dvh001-24 mc-dvh-talk-take-another-drag-cig with dissolve
    pause
    stop sound fadeout 1.0
    scene sm1cs-dvh001-25 mc-dvh-talk-walk-towards-ash-tray with dissolve
    play voice2 d1s2_hmm noloop volume 1.5
    mc "So what do you think? Will you teach me how to be a better actor?"
    play voice3 girl34_thinking_hmm4 noloop
    dvh "Hmm..."
    play sound sfx_cloth_rustling2
    scene sm1cs-dvh001-26 mc-dvh-talk-put-out-cig with dissolve
    play voice3 girl34_no_nah2 noloop
    dvh "I will give you the truth. I will not help you."
    play voice2 mc_disappointed_off2 noloop
    mc "Oh..."
    dvh "I have seen too many men, like you, come to the theater to woo actresses with your flashy smiles and cheap words."
    scene sm1cs-dvh001-27 mc-dvh-talk-alt-camera with dissolve
    play voice2 mc_happy_yay2 noloop
    mc "I promise, that's not what I want to do."
    play sound sfx_cloth_rustling1
    scene sm1cs-dvh001-28 mc-dvh-talk-wide-shot with dissolve
    play voice3 girl34_disappointed_ehh2 noloop
    dvh "Words are cheap. I believe in actions. In {i}actors{/i}."
    dvh "Prove yourself to me. Then... perhaps I will consider teaching you."
    play voice2 mc_thinking_hm noloop
    mc "Thanks for{w}, wait what?"
    scene sm1cs-dvh001-29 mc-dvh-talk-mc-side with dissolve
    play voice3 girl34_disappointed_eem3 noloop
    dvh "You have to prove to me, and this theater, that you are worth the work."
    dvh "I do see potential in you. But until I see that you are not just another Bram, I'm not going to waste any extra time on."
    dvh "Do you understand?"
    scene sm1cs-dvh001-28 mc-dvh-talk-wide-shot with dissolve
    play voice2 mc_happy_yes1 noloop
    mc "Oh, uh, yeah! Actually, not at all. I'm not sure how I should prove myself."
    scene sm1cs-dvh001-30 mc-dvh-talk-agree-move-closer with dissolve
    play voice3 girl34_arrogant_laugh2 noloop
    dvh "You will be here for rehearsal. You will learn the part, even though you are not the part."
    dvh "You will work, you will listen, you will pay attention."
    dvh "Improve your skill as an actor, and that is how you will show me that you are serious."
    scene sm1cs-dvh001-31 mc-dvh-walk-towards-door with dissolve
    play sound sfx_heels_steps2 loop
    play voice2 mc_yes_okay2 noloop
    mc "Oh, okay - yeah, I can do that!"
    play voice3 girl34_arrogant_ugu2 noloop
    dvh "Try not to disappoint me, [mcname]. And if you do, just make it quick."
    scene sm1cs-dvh001-32 mc-dvh-final-scene-mc-thinking with dissolve
    play voice2 mc_yes_yes7 noloop
    mc "I will do my best! Thank you Ms. Van der Haute!"
    play sound sfx_door_open6
    mct "Hell yeah, time to... Do some acting!"
    stop music fadeout 3.0
    $ renpy.music.set_volume(1.0, 3.0, "freeroam_music1" )
    $ renpy.music.set_volume(1.0, 1.0, "freeroam_sound1" )
    $ renpy.music.set_volume(1.0, 1.0, "freeroam_sound2" )
    $ StoryController.end_scene(DVH_STORY, 1, 0, 1)
    return
label sm1cs_dvh001_m01_c01:
    $ player.set_choice("sm1cs_dvh001_youre_differe")
    $ CharacterController.get_character("dvh").add_point()
    return
label sm1cs_dvh001_unlocks:
    call sm1cs_dvh001_m01_c01 from _call_sm1cs_dvh001_m01_c01_1
    if config_storyline_mode is True:
        $ execute_storyline_config(DVH_STORY)
    return